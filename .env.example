# =============================================================================
# Lakehouse Platform Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# This configuration supports:
# - SeaweedFS (S3-compatible object storage)
# - Polaris Catalog (Apache Iceberg REST Catalog)
# - OpenMetadata (Data governance & lineage)
# - Apache Spark
# - Mage.ai (Pipeline orchestration)
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# SeaweedFS S3 Configuration
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_BUCKET=lakehouse
S3_WAREHOUSE=s3a://lakehouse/warehouse

# -----------------------------------------------------------------------------
# Iceberg Configuration (Polaris Catalog)
# -----------------------------------------------------------------------------
ICEBERG_CATALOG_URI=http://localhost:8100
ICEBERG_WAREHOUSE=${S3_WAREHOUSE}

# -----------------------------------------------------------------------------
# Polaris Catalog Configuration
# -----------------------------------------------------------------------------
POLARIS_CATALOG_URL=http://localhost:8100
POLARIS_CATALOG_NAME=lakehouse

# -----------------------------------------------------------------------------
# OpenMetadata Configuration
# -----------------------------------------------------------------------------
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_API_KEY=openmetadata_api_key

# -----------------------------------------------------------------------------
# Apache Spark Configuration
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://localhost:7077
SPARK_HOME=/opt/spark

# -----------------------------------------------------------------------------
# Mage.ai Configuration (optional)
# -----------------------------------------------------------------------------
MAGE_CODE_PATH=/home/src
MAGE_DATA_DIR=/opt/mage/data

# -----------------------------------------------------------------------------
# Airflow Configuration (optional - legacy, being replaced by Mage.ai)
# -----------------------------------------------------------------------------
# IMPORTANT: Change these defaults before deploying!
AIRFLOW_ADMIN_USER=your_airflow_user
AIRFLOW_ADMIN_PASSWORD=your_secure_password_here
# Generate Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
